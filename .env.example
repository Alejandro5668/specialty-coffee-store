# Payment provider (sandbox only). Fill locally; never commit real values.
PAYMENT_API_URL=
PAYMENT_PUBLIC_KEY=
PAYMENT_PRIVATE_KEY=
PAYMENT_EVENTS_SECRET=
PAYMENT_INTEGRITY_SECRET=

# Backend
AWS_REGION=us-east-2
# Comma-separated exact origins; * is refused. Behind API Gateway set TRUST_PROXY_HOPS=1.
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0

# DynamoDB table names are TABLE_PREFIX-products, -variants, -customers, -transactions
TABLE_PREFIX=coffee-store
